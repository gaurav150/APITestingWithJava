# .env.example
# Copy to .env and adjust if needed. These are the base URLs each
# "microservice" name resolves to when containers are on the same
# docker-compose network (backend). From your HOST machine (e.g. Postman,
# your local REST Assured test run), use the localhost mapped port instead.

# --- From INSIDE the docker network (container-to-container) ---
PRODUCTS_TARGET_URL=https://fakestoreapi.com
POSTS_TARGET_URL=https://jsonplaceholder.typicode.com

# --- From your HOST machine (outside docker, e.g. Postman / local tests) ---
WIREMOCK_BASE_URL=http://localhost:8181
