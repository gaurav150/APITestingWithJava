{
  "request": {
    "method": "POST",
    "url": "/products",
    "bodyPatterns": [
      {
        "equalToJson": "{\"id\": 0, \"title\": \"string\", \"price\": 0.1, \"description\": \"string\", \"category\": \"string\", \"image\": \"http://example.com\"}",
        "ignoreArrayOrder": true,
        "ignoreExtraElements": true
      }
    ]
  },
  "response": {
    "status": 201,
    "jsonBody": {
      "id": 0,
      "title": "string",
      "price": 0.1,
      "description": "string",
      "category": "string",
      "image": "http://example.com"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}